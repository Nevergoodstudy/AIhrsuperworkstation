{
  "name": "talent-desk-workstation",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web npm:dev:api npm:dev:web",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "admin:create": "node server/cli.mjs create",
    "admin:reset": "node server/cli.mjs reset",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs verify"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.71.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
