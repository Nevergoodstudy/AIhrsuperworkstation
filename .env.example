# 本地开发；正式部署将 APP_URL 改为真实 HTTPS 根地址，不能包含路径。
NODE_ENV=development
APP_URL=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
COMPANY_NAME=企业招聘工作区
# 仅在受信任的单层反向代理后启用；Compose 会覆盖为 1。
TRUST_PROXY=0

# Compose 的 HTTPS 入口域名，需事先解析至服务器；不要添加 https://。
SITE_ADDRESS=hr.example.com
# 可选：更换数据卷时使用，日常保持默认；备份卷不要与数据卷重名。
TALENT_DATA_VOLUME=talentdesk_talent_data
TALENT_BACKUP_VOLUME=talentdesk_talent_backups

# 可选：未配置时可正常使用人工流程和关键词证据分析。
# 不要将密钥写入前端、仓库或截图。模型名称按实际服务商填写。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# 可选：凭证中的特殊字符须 URL 编码。填写受企业批准的真实邮件服务。
# 示例格式：smtps://user:URL_ENCODED_PASSWORD@mail.example.com:465
SMTP_URL=
MAIL_FROM=
